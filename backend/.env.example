# PostgreSQL connection used by the FastAPI backend.
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/legallens

# JWT signing key. Replace this with a long random secret outside local development.
SECRET_KEY=replace-with-a-long-random-secret

# The address of the running Next.js frontend. Password-reset links use this value.
FRONTEND_URL=http://localhost:3000

# SMTP settings for password-reset messages. For Gmail, use a Google App Password,
# not your normal Google account password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_FROM=your_email@gmail.com
MAIL_TLS=True
MAIL_SSL=False
# Fail quickly instead of keeping the reset form loading when SMTP is unavailable.
MAIL_SEND_TIMEOUT_SECONDS=15
